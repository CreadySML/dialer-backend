# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lms_dialer
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (for future auth)
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d

# CORS — frontend origin
CLIENT_ORIGIN=http://localhost:3000

# Super Admin bootstrap (auto-created on first server start if no superadmin exists)
SUPERADMIN_NAME=Super Admin
SUPERADMIN_EMAIL=admin@lms.local
SUPERADMIN_PASSWORD=Admin@12345
